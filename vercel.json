{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; media-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/chapter/04",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/4",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/chapter/05",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/chapter/06",
      "destination": "/7/",
      "permanent": false
    },
    {
      "source": "/chapter/07",
      "destination": "/7/",
      "permanent": false
    },
    {
      "source": "/chapter/08",
      "destination": "/9/",
      "permanent": false
    },
    {
      "source": "/chapter/09",
      "destination": "/9/",
      "permanent": false
    },
    {
      "source": "/chapter/11",
      "destination": "/11/",
      "permanent": false
    }
  ]
}
